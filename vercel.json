{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "^/.*\\.(js|css|png|jpg|jpeg|svg|ico|json)$",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/$0"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}
